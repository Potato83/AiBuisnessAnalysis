# Copy to backend/agent/.env. Loaded automatically; process environment wins.
# Fill APIMIRA_API_KEY locally. Without a key, llm mode raises an explicit error.
AGENT_MODE=llm
APIMIRA_API_KEY=
APIMIRA_BASE_URL=https://apimira.com/v1
APIMIRA_MODEL=deepseek/deepseek-v4.1-flash
AGENT_LLM_TIMEOUT_SECONDS=180
AGENT_LLM_MAX_TOKENS=6000
AGENT_LLM_TEMPERATURE=0.5
AGENT_LLM_TOP_P=1
